<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agent-wechat.sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/you/agent-wechat/.venv/bin/agent-wechat</string>
        <string>sync</string>
        <string>--json</string>
        <string>--account</string>
        <string>wxid_testacct01_ab12</string>
    </array>
    <!-- 每 6 小时一次；最小 5 分钟。默认不随登录启动。 -->
    <key>StartInterval</key>
    <integer>21600</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/you/.agent-wechat/sync.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/you/.agent-wechat/sync.launchd.err.log</string>
</dict>
</plist>
