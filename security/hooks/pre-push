#!/bin/sh
# 全量门禁（步骤表在 check.sh 文件头）：`scripts/check.sh`。本机实测 133–156 s，绝大部分是 pytest。
#
# 为什么在这里而不是 pre-commit：绝大多数时间花在 pytest 全量上（133–156 s 里占九成），逐次提交都付会让「钩子碍事」
# 变成绕过的理由；而 push 是内容离开本机的动作（本仓的红线是**不外流**），值得那几分钟。
# 参数（remote 名与 URL）刻意不用：本仓没有「只推某些远端才检查」的形态，一律跑。
set -u
root=$(git rev-parse --show-toplevel) || exit 1
exec "$root/scripts/check.sh"
